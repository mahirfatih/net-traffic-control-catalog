{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/mahirfatih/net-traffic-control-catalog/main/schema.json",
  "title": "Net Traffic Control Catalog",
  "type": "object",
  "required": [
    "version",
    "categories"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "generated": {
      "type": "string"
    },
    "categories": {
      "type": "object",
      "description": "host -> category. Unknown category names are ignored by the app.",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "analytics",
          "ads",
          "social",
          "messaging",
          "cdn",
          "crash",
          "video",
          "music",
          "gaming",
          "shopping",
          "search",
          "news",
          "email",
          "encyclopedia",
          "software",
          "ai",
          "finance",
          "government",
          "health",
          "transport",
          "telecom",
          "travel",
          "education",
          "sports",
          "crypto",
          "dating",
          "maps",
          "adult",
          "gambling",
          "other"
        ]
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "domains"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}